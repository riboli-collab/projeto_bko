# Conexão com o Postgres. No Railway, use a referência ao serviço do banco:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://usuario:senha@localhost:5432/esteira

# Assina o cookie de sessão. Gere o seu — não use este valor:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sem ele ninguém entra, nem local: é falha de configuração, e falha de
# configuração que destranca a porta é a pior espécie.
# Trocá-lo derruba todas as sessões em aberto, de todo mundo.
SEGREDO_DA_SESSAO=troque-isto-por-um-valor-sorteado

# Onde os anexos (contrato social, RG, comprovante) são gravados.
# Em produção precisa apontar para um volume montado — disco de contêiner é
# efêmero e os arquivos somem no redeploy.
ARMAZENAMENTO_DIR=/dados/armazenamento
